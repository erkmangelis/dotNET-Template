<Project Sdk="Microsoft.NET.Sdk">

  <!-- Packs everything under templates/ into a `dotnet new` template package. -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Erkmangelis.Templates</PackageId>
    <Version>0.6.0</Version>
    <Title>Erkmangelis .NET templates</Title>
    <Authors>erkmangelis</Authors>
    <Description>A hardened ASP.NET Core HTTP API template for .NET 10 with optional sign-in (ASP.NET Core Identity or OpenID Connect), PostgreSQL, SQL Server or SQLite, background jobs (hosted or Hangfire), a worker, .NET Aspire and AI agent guidance.</Description>
    <PackageTags>dotnet-new;templates;aspnetcore;webapi;postgresql;sqlserver;sqlite;identity;hangfire;aspire</PackageTags>
    <RepositoryUrl>https://github.com/erkmangelis/dotNET-Template</RepositoryUrl>
    <PackageProjectUrl>https://github.com/erkmangelis/dotNET-Template</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128: a template package has no lib/ folder by design. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates/**/*" Exclude="templates/**/bin/**;templates/**/obj/**;templates/**/TestResults/**;templates/**/.vs/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
