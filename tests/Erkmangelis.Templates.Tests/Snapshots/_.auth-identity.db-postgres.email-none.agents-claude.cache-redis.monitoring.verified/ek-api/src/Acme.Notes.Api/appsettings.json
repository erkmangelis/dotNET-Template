{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "ExposeOpenApi": false,
    "UseHttpsRedirection": true,
    "ShutdownTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Localization": {
    "Languages": [ "en", "tr" ],
    "DefaultLanguage": "en"
  },
  "FeatureManagement": {
    "NoteExport": true
  },
  "Caching": {
    "ExpirationSeconds": 300,
    "LocalExpirationSeconds": 30,
    "MaximumPayloadBytes": 1048576,
    "OutputExpirationSeconds": 60
  },
  "Monitoring": {
    "Prometheus": {
      "Enabled": false,
      "Port": 9464
    }
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
  },
  "Identity": {
    "SignIn": {
      "RequireConfirmedEmail": true
    }
  }
}
