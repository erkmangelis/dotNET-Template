# Copy to .env (never committed) and fill in. docker compose reads it automatically.

# Host port for the API.
API_PORT=8080

# SQL Server's licence terms: https://go.microsoft.com/fwlink/?linkid=857698. Set Y to accept them.
MSSQL_ACCEPT_EULA=
# Express is free, also in production (10 GB per database). Developer is free but not for production.
MSSQL_PID=Express
# The sa password: 8 or more characters from three of upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=
# Host port for the database, bound to 127.0.0.1 only.
MSSQL_PORT=1433

# The OpenID Connect provider that owns the accounts, for example https://sso.example.com/realms/myapp.
OIDC_AUTHORITY=
# The audience the provider puts in access tokens for this API.
OIDC_AUDIENCE=
# Where tokens keep roles: roles (Entra ID) or realm_access.roles (Keycloak).
OIDC_ROLE_CLAIM=roles

# Object storage. The bundled RustFS takes these keys as its own; for R2, use an API token's keys.
# Generate them with: openssl rand -hex 20
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Leave as they are for the bundled storage. For R2: https://<account>.r2.cloudflarestorage.com and auto.
STORAGE_SERVICE_URL=http://storage:9000
STORAGE_REGION=us-east-1
# The address clients use for signed links: the storage's public hostname in production.
STORAGE_PUBLIC_URL=http://localhost:9000
STORAGE_BUCKET=files
# Create the bucket at startup. Set false for a provider whose keys may not create buckets.
STORAGE_CREATE_BUCKET=true
# Scan uploads with ClamAV: set true and start the scan profile.
FILES_SCANNING=false

# Cloudflare Tunnel token, only for: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Optional OpenTelemetry collector, for example http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
