{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "ExposeOpenApi": true
  },
  "Webhooks": {
    "Outgoing": {
      "AllowPrivateNetworks": true,
      "AllowHttp": true
    }
  },
  "Notifications": {
    "Push": { "Transport": "Log" },
    "Sms": { "Transport": "Log" }
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDevelopmentData": true
  }
}
