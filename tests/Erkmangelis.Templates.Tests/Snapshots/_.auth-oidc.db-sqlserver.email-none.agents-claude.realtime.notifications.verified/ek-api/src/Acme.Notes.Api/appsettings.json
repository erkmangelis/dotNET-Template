{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "ExposeOpenApi": false,
    "UseHttpsRedirection": true,
    "ShutdownTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Realtime": {
    "HandshakeTimeoutSeconds": 10,
    "KeepAliveSeconds": 15,
    "MaxMessageBytes": 16384,
    "MaxQueuedMessages": 256
  },
  "Notifications": {
    "DispatchIntervalSeconds": 5,
    "RetryDelaysSeconds": [ 10, 60, 300, 1800 ],
    "RetentionDays": 90,
    "Push": {
      "Transport": "None",
      "Fcm": {
        "ProjectId": null,
        "ServiceAccountJson": null
      },
      "Apns": {
        "TeamId": null,
        "KeyId": null,
        "PrivateKey": null,
        "BundleId": null,
        "UseSandbox": false
      }
    },
    "Sms": {
      "Transport": "None",
      "Twilio": {
        "AccountSid": null,
        "AuthToken": null,
        "From": null
      }
    }
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
  },
  "Oidc": {
    "Authority": "",
    "Audience": "",
    "RoleClaim": "roles"
  }
}
