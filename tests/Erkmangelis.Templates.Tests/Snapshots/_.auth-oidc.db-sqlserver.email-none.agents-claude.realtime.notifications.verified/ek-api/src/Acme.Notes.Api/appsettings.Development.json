{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "ExposeOpenApi": true
  },
  "Notifications": {
    "Push": { "Transport": "Log" },
    "Sms": { "Transport": "Log" }
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDevelopmentData": true
  },
  "Oidc": {
    "Authority": "http://localhost:8081/realms/acme-notes",
    "Audience": "acme-notes-api",
    "RequireHttpsMetadata": false,
    "RoleClaim": "realm_access.roles"
  },
  "DevelopmentSeed": {
    "Subject": "00000000-0000-0000-0000-000000000000"
  }
}
