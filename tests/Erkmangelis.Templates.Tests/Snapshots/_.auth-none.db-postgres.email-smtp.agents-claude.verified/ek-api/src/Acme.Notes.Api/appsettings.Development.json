{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "ExposeOpenApi": true
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDevelopmentData": true
  },
  "Email": {
    "Transport": "Log",
    "FromAddress": "noreply@example.com"
  }
}
