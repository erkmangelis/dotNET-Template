# Copy to .env (never committed) and fill in. docker compose reads it automatically.

# Host port for the API.
API_PORT=8080

# The OpenID Connect provider that owns the accounts, for example https://sso.example.com/realms/myapp.
OIDC_AUTHORITY=
# The audience the provider puts in access tokens for this API.
OIDC_AUDIENCE=
# Where tokens keep roles: roles (Entra ID) or realm_access.roles (Keycloak).
OIDC_ROLE_CLAIM=roles

# Cloudflare Tunnel token, only for: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Monitoring, only for: docker compose --profile monitoring up -d. Grafana's admin password:
GRAFANA_ADMIN_PASSWORD=
# How long Prometheus keeps metrics.
PROMETHEUS_RETENTION=15d
# Where traces and logs go. Unset, they go to the monitoring profile's collector; empty sends nothing.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# Rate limiting stays on in production. Load tests from one address may turn it off.
RATE_LIMITING_ENABLED=true
