{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "ExposeOpenApi": false,
    "UseHttpsRedirection": true,
    "ShutdownTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Webhooks": {
    "Incoming": {
      "Sources": {},
      "ToleranceSeconds": 300,
      "RetryDelaysSeconds": [ 10, 60, 300, 1800, 7200 ],
      "ProcessIntervalSeconds": 5,
      "RetentionDays": 30
    },
    "Outgoing": {
      "RetryDelaysSeconds": [ 5, 300, 1800, 7200, 18000, 36000 ],
      "DispatchIntervalSeconds": 5,
      "TimeoutSeconds": 15,
      "AllowPrivateNetworks": false,
      "AllowHttp": false,
      "RetentionDays": 30
    }
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
  }
}
