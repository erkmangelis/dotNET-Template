{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "ExposeOpenApi": false,
    "UseHttpsRedirection": true,
    "ShutdownTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Storage": {
    "Region": "us-east-1",
    "Bucket": "files",
    "ForcePathStyle": true,
    "CreateBucket": false
  },
  "Files": {
    "MaxSizeBytes": 26214400,
    "AllowedTypes": [ "image/png", "image/jpeg", "image/webp", "image/gif", "application/pdf", "text/plain", "text/csv" ],
    "UploadLinkMinutes": 15,
    "DownloadLinkMinutes": 5,
    "TemporaryFileHours": 24,
    "RejectedFileHours": 24,
    "OrphanGraceHours": 24,
    "CleanupIntervalMinutes": 60,
    "ThumbnailSize": 256,
    "Scanning": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 3310
    },
    "Tus": {
      "Enabled": true,
      "ExpirationHours": 24
    }
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
  }
}
