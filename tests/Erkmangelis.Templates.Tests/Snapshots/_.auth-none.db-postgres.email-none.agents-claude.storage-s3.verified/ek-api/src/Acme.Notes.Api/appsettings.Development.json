{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "ExposeOpenApi": true
  },
  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "CreateBucket": true
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDevelopmentData": true
  }
}
