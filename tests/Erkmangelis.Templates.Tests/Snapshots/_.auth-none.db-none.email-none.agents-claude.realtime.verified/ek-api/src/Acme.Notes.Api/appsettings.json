{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "ExposeOpenApi": false,
    "UseHttpsRedirection": true,
    "ShutdownTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Realtime": {
    "HandshakeTimeoutSeconds": 10,
    "KeepAliveSeconds": 15,
    "MaxMessageBytes": 16384,
    "MaxQueuedMessages": 256
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
  }
}
