<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Acme.Notes.Worker</RootNamespace>
    <!-- The API's id, so both read the same development secrets. -->
    <UserSecretsId>Acme.Notes-00000000-0000-0000-0000-000000000000</UserSecretsId>
    <!-- The API's appsettings files come along with its project; this project's own copies are
         published last and win. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Acme.Notes.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The worker runs the API's jobs with the API's code: entities, the database and the job classes. -->
    <ProjectReference Include="..\Acme.Notes.Api\Acme.Notes.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Acme.Notes.Api.Common" />
    <Using Include="Acme.Notes.Api.Data" />
    <Using Include="Acme.Notes.Api.Features.Notes" />
    <Using Include="Acme.Notes.Api.Infrastructure" />
    <Using Include="Acme.Notes.Api.Infrastructure.Idempotency" />
    <Using Include="Acme.Notes.Api.Infrastructure.Jobs" />
  </ItemGroup>

</Project>
