# Copy to .env (never committed) and fill in. docker compose reads it automatically.

# Host port for the API.
API_PORT=8080

# SQL Server's licence terms: https://go.microsoft.com/fwlink/?linkid=857698. Set Y to accept them.
MSSQL_ACCEPT_EULA=
# Express is free, also in production (10 GB per database). Developer is free but not for production.
MSSQL_PID=Express
# The sa password: 8 or more characters from three of upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=
# Host port for the database, bound to 127.0.0.1 only.
MSSQL_PORT=1433

# Cloudflare Tunnel token, only for: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Optional OpenTelemetry collector, for example http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
