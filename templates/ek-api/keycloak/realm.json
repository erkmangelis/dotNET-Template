{
  "realm": "ek-app-slug",
  "displayName": "MyProject (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Can do everything" },
      { "name": "auditor", "description": "Can read everything" }
    ]
  },
  "clients": [
    {
      "clientId": "ek-app-slug-api",
      "name": "MyProject API",
      "description": "The audience of access tokens for the API. Nobody signs in to it directly.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "ek-app-slug-web",
      "name": "MyProject web app",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:3000/*" },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ek-app-slug-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "6f1c2b9e-0d4a-4c3e-9b7a-2e5d8f1a3c40",
      "username": "dev@example.com",
      "email": "dev@example.com",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "dev-password", "temporary": false }],
      "realmRoles": ["default-roles-ek-app-slug", "admin"]
    }
  ]
}
