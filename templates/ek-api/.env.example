# Copy to .env (never committed) and fill in. docker compose reads it automatically.

# Host port for the API.
API_PORT=8080
#if (UsePostgres)

# Database password. Generate one with: openssl rand -base64 32
POSTGRES_PASSWORD=
# Host port for the database, bound to 127.0.0.1 only.
POSTGRES_PORT=5432
#endif

#if (UseExternal)
# Sign-in providers: the client id of your app at each one. Leave empty to turn a provider off.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=

#endif
#if (UseOidc)
# The OpenID Connect provider that owns the accounts, for example https://sso.example.com/realms/myapp.
OIDC_AUTHORITY=
# The audience the provider puts in access tokens for this API.
OIDC_AUDIENCE=
# Where tokens keep roles: roles (Entra ID) or realm_access.roles (Keycloak).
OIDC_ROLE_CLAIM=roles

#endif
#if (UseSmtp)
# Email. The sender address must be allowed by your SMTP provider.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# StartTls for port 587, SslOnConnect for 465, None only for a private relay or Mailpit.
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=

#endif
# Cloudflare Tunnel token, only for: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Optional OpenTelemetry collector, for example http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=
