{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
//#if (UseDatabase)
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
//#endif
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "ExposeOpenApi": false,
    "UseHttpsRedirection": true,
    "ShutdownTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
//#if (UseHostedJobs)
  "Jobs": {
    "WorkerCount": 2,
    "QueueCapacity": 1000,
    "MaxAttempts": 5,
    "RetryDelaySeconds": 10,
    "IdempotencyRetentionDays": 7,
    "Schedules": {}
  },
//#endif
//#if (UseHangfire)
  "Jobs": {
    "Queue": "default",
    "RunServer": true,
    "WorkerCount": 2,
    "MaxAttempts": 5,
    "RetryDelaySeconds": 10,
    "IdempotencyRetentionDays": 7,
    "Dashboard": false,
    "PollIntervalSeconds": 5,
    "Schedules": {}
  },
//#endif
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
//#if (UseDatabase)
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
//#endif
//#if (UseIdentity)
  },
  "Identity": {
    "SignIn": {
      "RequireConfirmedEmail": true
    }
//#endif
//#if (UseExternal)
  },
  "ExternalAuth": {
    "Providers": {
      "Google": {
        "Authority": "https://accounts.google.com",
        "ClientIds": []
      },
      "Apple": {
        "Authority": "https://appleid.apple.com",
        "ClientIds": []
      },
      "Microsoft": {
        "Authority": "https://login.microsoftonline.com/common/v2.0",
        "ClientIds": [],
        "EmailVerifiedClaim": "xms_edov"
      }
    }
//#endif
//#if (UseOidc)
  },
  "Oidc": {
    "Authority": "",
    "Audience": "",
    "RoleClaim": "roles"
//#endif
//#if (UseSmtp)
  },
  "Email": {
    "Transport": "Smtp",
    "FromAddress": "",
    "FromName": "MyProject",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls"
    }
//#endif
  }
}
