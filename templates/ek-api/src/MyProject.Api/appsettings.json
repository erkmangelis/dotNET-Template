{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
//#if (UseDatabase)
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
//#endif
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "ExposeOpenApi": false,
    "UseHttpsRedirection": true,
    "ShutdownTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
//#if (UseHostedJobs)
  "Jobs": {
    "WorkerCount": 2,
    "QueueCapacity": 1000,
    "MaxAttempts": 5,
    "RetryDelaySeconds": 10,
    "IdempotencyRetentionDays": 7,
    "Schedules": {}
  },
//#endif
//#if (UseHangfire)
  "Jobs": {
    "Queue": "default",
//#if (UseWorker)
    "RunServer": false,
//#else
    "RunServer": true,
//#endif
    "WorkerCount": 2,
    "MaxAttempts": 5,
    "RetryDelaySeconds": 10,
    "IdempotencyRetentionDays": 7,
    "Dashboard": false,
    "PollIntervalSeconds": 5,
    "Schedules": {}
  },
//#endif
//#if (UseStorage)
  "Storage": {
    "Region": "us-east-1",
    "Bucket": "files",
    "ForcePathStyle": true,
    "CreateBucket": false
  },
  "Files": {
    "MaxSizeBytes": 26214400,
    "AllowedTypes": [ "image/png", "image/jpeg", "image/webp", "image/gif", "application/pdf", "text/plain", "text/csv" ],
    "UploadLinkMinutes": 15,
    "DownloadLinkMinutes": 5,
    "TemporaryFileHours": 24,
    "RejectedFileHours": 24,
    "OrphanGraceHours": 24,
    "CleanupIntervalMinutes": 60,
    "ThumbnailSize": 256,
    "Scanning": {
      "Enabled": false,
      "Host": "localhost",
      "Port": 3310
    },
    "Tus": {
      "Enabled": true,
      "ExpirationHours": 24
    }
  },
//#endif
//#if (UseRealtime)
  "Realtime": {
    "HandshakeTimeoutSeconds": 10,
    "KeepAliveSeconds": 15,
    "MaxMessageBytes": 16384,
    "MaxQueuedMessages": 256
  },
//#endif
//#if (UseWebhooks)
  "Webhooks": {
    "Incoming": {
      "Sources": {},
      "ToleranceSeconds": 300,
      "RetryDelaysSeconds": [ 10, 60, 300, 1800, 7200 ],
      "ProcessIntervalSeconds": 5,
      "RetentionDays": 30
    },
    "Outgoing": {
      "RetryDelaysSeconds": [ 5, 300, 1800, 7200, 18000, 36000 ],
      "DispatchIntervalSeconds": 5,
      "TimeoutSeconds": 15,
      "AllowPrivateNetworks": false,
      "AllowHttp": false,
      "RetentionDays": 30
    }
  },
//#endif
//#if (UseNotifications)
  "Notifications": {
    "DispatchIntervalSeconds": 5,
    "RetryDelaysSeconds": [ 10, 60, 300, 1800 ],
    "RetentionDays": 90,
    "Push": {
      "Transport": "None",
      "Fcm": {
        "ProjectId": null,
        "ServiceAccountJson": null
      },
      "Apns": {
        "TeamId": null,
        "KeyId": null,
        "PrivateKey": null,
        "BundleId": null,
        "UseSandbox": false
      }
    },
    "Sms": {
      "Transport": "None",
      "Twilio": {
        "AccountSid": null,
        "AuthToken": null,
        "From": null
      }
    }
  },
//#endif
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
//#if (UseDatabase)
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
//#endif
//#if (UseIdentity)
  },
  "Identity": {
    "SignIn": {
      "RequireConfirmedEmail": true
    }
//#endif
//#if (UseExternal)
  },
  "ExternalAuth": {
    "Providers": {
      "Google": {
        "Authority": "https://accounts.google.com",
        "ClientIds": []
      },
      "Apple": {
        "Authority": "https://appleid.apple.com",
        "ClientIds": []
      },
      "Microsoft": {
        "Authority": "https://login.microsoftonline.com/common/v2.0",
        "ClientIds": [],
        "EmailVerifiedClaim": "xms_edov"
      }
    }
//#endif
//#if (UseOidc)
  },
  "Oidc": {
    "Authority": "",
    "Audience": "",
    "RoleClaim": "roles"
//#endif
//#if (UseSmtp)
  },
  "Email": {
    "Transport": "Smtp",
    "FromAddress": "",
    "FromName": "MyProject",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls"
    }
//#endif
  }
}
