{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
//#if (UsePostgres)
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
//#endif
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "ExposeOpenApi": false,
    "UseHttpsRedirection": true,
    "ShutdownTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
//#if (UsePostgres)
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
//#endif
//#if (UseIdentity)
  },
  "Identity": {
    "SignIn": {
      "RequireConfirmedEmail": true
    }
//#endif
//#if (UseExternal)
  },
  "ExternalAuth": {
    "Providers": {
      "Google": {
        "Authority": "https://accounts.google.com",
        "ClientIds": []
      },
      "Apple": {
        "Authority": "https://appleid.apple.com",
        "ClientIds": []
      },
      "Microsoft": {
        "Authority": "https://login.microsoftonline.com/common/v2.0",
        "ClientIds": [],
        "EmailVerifiedClaim": "xms_edov"
      }
    }
//#endif
//#if (UseOidc)
  },
  "Oidc": {
    "Authority": "",
    "Audience": "",
    "RoleClaim": "roles"
//#endif
//#if (UseSmtp)
  },
  "Email": {
    "Transport": "Smtp",
    "FromAddress": "",
    "FromName": "MyProject",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "StartTls"
    }
//#endif
  }
}
