{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
//#if (UsePostgres)
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
//#endif
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Api": {
    "ExposeOpenApi": false,
    "UseHttpsRedirection": true,
    "ShutdownTimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "ForwardedHeaders": {
    "KnownNetworks": [],
    "KnownProxies": [],
    "ForwardLimit": 1
//#if (UsePostgres)
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDevelopmentData": false
//#endif
//#if (UseIdentity)
  },
  "Identity": {
    "SignIn": {
      "RequireConfirmedEmail": true
    }
//#endif
  }
}
