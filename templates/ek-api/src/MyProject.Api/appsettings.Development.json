{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "ExposeOpenApi": true
//#if (UsePostgres)
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDevelopmentData": true
//#endif
//#if (UseOidc)
  },
  "Oidc": {
    "Authority": "http://localhost:8081/realms/ek-app-slug",
    "Audience": "ek-app-slug-api",
    "RequireHttpsMetadata": false,
    "RoleClaim": "realm_access.roles"
//#endif
//#if (UseSmtp)
  },
  "Email": {
    "Transport": "Log",
    "FromAddress": "noreply@example.com"
//#endif
  }
}
