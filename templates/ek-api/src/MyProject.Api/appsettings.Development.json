{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "ExposeOpenApi": true
//#if (UseSqlite)
  },
  "ConnectionStrings": {
    "Default": "Data Source=app.db"
//#endif
//#if (UseDatabase)
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDevelopmentData": true
//#endif
//#if (UseOidc)
  },
  "Oidc": {
    "Authority": "http://localhost:8081/realms/ek-app-slug",
    "Audience": "ek-app-slug-api",
    "RequireHttpsMetadata": false,
    "RoleClaim": "realm_access.roles"
  },
  "DevelopmentSeed": {
    "Subject": "6f1c2b9e-0d4a-4c3e-9b7a-2e5d8f1a3c40"
//#endif
//#if (UseSmtp)
  },
  "Email": {
    "Transport": "Log",
    "FromAddress": "noreply@example.com"
//#endif
  }
}
