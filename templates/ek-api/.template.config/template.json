{
  "$schema": "http://json.schemastore.org/template",
  "author": "erkmangelis",
  "classifications": [ "Web", "API", "Service" ],
  "identity": "Erkmangelis.Templates.Api",
  "groupIdentity": "Erkmangelis.Templates.Api",
  "name": "Hardened ASP.NET Core HTTP API (ek)",
  "description": "A hardened HTTP API on .NET 10: validation, ProblemDetails, OpenAPI, paging, rate limits, security headers, OpenTelemetry, health checks, tests, containers, and optional sign-in, PostgreSQL, SQL Server or SQLite, background jobs, a worker, file storage, CSV, Excel and PDF documents, .NET Aspire and AI agent guidance.",
  "shortName": "ek-api",
  "sourceName": "MyProject",
  "guids": [ "0f6a3c1e-7d4b-4a52-9c1e-5b8d2f7a9e30" ],
  "preferNameDirectory": true,
  "defaultName": "MyApi",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Authentication. Every choice except 'none' needs a database, and turns PostgreSQL on when --db is none.",
      "choices": [
        { "choice": "none", "description": "No authentication." },
        { "choice": "identity", "description": "Accounts in your database with ASP.NET Core Identity: passwords, bearer tokens or cookies, MFA, passkeys." },
        { "choice": "external", "description": "Everything in 'identity', plus sign-in with Google, Apple and Microsoft." },
        { "choice": "oidc", "description": "Accounts in a hosted OpenID Connect provider such as Keycloak or Entra ID; the API validates its access tokens." }
      ],
      "defaultValue": "none"
    },
    "db": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Database, through EF Core with migrations, audit history and a compose deployment.",
      "choices": [
        { "choice": "none", "description": "No database; notes are kept in memory." },
        { "choice": "postgres", "description": "PostgreSQL 18 through Npgsql, with Testcontainers." },
        { "choice": "sqlserver", "description": "SQL Server 2022 through Microsoft.Data.SqlClient, with Testcontainers. Runs on amd64 only." },
        { "choice": "sqlite", "description": "SQLite in a file next to the app: one machine, light write load." }
      ],
      "defaultValue": "none"
    },
    "email": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Email delivery. 'smtp' adds an email transport (SMTP with MailKit, or the log in development) and templated messages.",
      "choices": [
        { "choice": "none", "description": "No email delivery." },
        { "choice": "smtp", "description": "SMTP through MailKit, with a log transport for development." }
      ],
      "defaultValue": "none"
    },
    "jobs": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Background jobs. 'hangfire' needs a database, and turns PostgreSQL on when --db is none.",
      "choices": [
        { "choice": "none", "description": "No job framework; only the scoped background loop for housekeeping." },
        { "choice": "hosted", "description": "In-process queue and cron schedules on hosted services. Queued jobs are lost on restart." },
        { "choice": "hangfire", "description": "Hangfire: durable queued and scheduled jobs in your database, retries, a dashboard." }
      ],
      "defaultValue": "none"
    },
    "storage": {
      "type": "parameter",
      "datatype": "choice",
      "description": "File storage. 's3' adds uploads, downloads and signed links on any S3-compatible storage, and needs a database: it turns PostgreSQL on when --db is none.",
      "choices": [
        { "choice": "none", "description": "No file storage." },
        { "choice": "s3", "description": "Private files on S3-compatible storage (RustFS in compose, Cloudflare R2 or S3 in production): type checks, virus scanning, thumbnails, signed links, resumable uploads, cleanup." }
      ],
      "defaultValue": "none"
    },
    "documents": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Add CSV and Excel import and export of notes, and a PDF report.",
      "defaultValue": "false"
    },
    "worker": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Add a worker project that runs the API's jobs in its own process and container. Implies --jobs hangfire.",
      "defaultValue": "false"
    },
    "aspire": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Add a .NET Aspire AppHost that starts the API, the worker and the database for local development.",
      "defaultValue": "false"
    },
    "agents": {
      "type": "parameter",
      "datatype": "choice",
      "description": "Guidance files for AI coding agents.",
      "choices": [
        { "choice": "none", "description": "No agent guidance files." },
        { "choice": "shared", "description": "AGENTS.md, read by most coding agents." },
        { "choice": "claude", "description": "AGENTS.md plus a CLAUDE.md that imports it." }
      ],
      "defaultValue": "shared"
    },
    "UseAuth": {
      "type": "computed",
      "value": "(auth != \"none\")"
    },
    "UseIdentity": {
      "type": "computed",
      "value": "(auth == \"identity\" || auth == \"external\")"
    },
    "UseExternal": {
      "type": "computed",
      "value": "(auth == \"external\")"
    },
    "UseOidc": {
      "type": "computed",
      "value": "(auth == \"oidc\")"
    },
    "UsePostgres": {
      "type": "computed",
      "value": "(db == \"postgres\" || (db == \"none\" && (auth != \"none\" || jobs == \"hangfire\" || worker || storage == \"s3\")))"
    },
    "UseSqlServer": {
      "type": "computed",
      "value": "(db == \"sqlserver\")"
    },
    "UseSqlite": {
      "type": "computed",
      "value": "(db == \"sqlite\")"
    },
    "UseDatabase": {
      "type": "computed",
      "value": "(db != \"none\" || auth != \"none\" || jobs == \"hangfire\" || worker || storage == \"s3\")"
    },
    "UseJobs": {
      "type": "computed",
      "value": "(jobs != \"none\" || worker)"
    },
    "UseHostedJobs": {
      "type": "computed",
      "value": "(jobs == \"hosted\" && !worker)"
    },
    "UseHangfire": {
      "type": "computed",
      "value": "(jobs == \"hangfire\" || worker)"
    },
    "UseWorker": {
      "type": "computed",
      "value": "(worker)"
    },
    "UseAspire": {
      "type": "computed",
      "value": "(aspire)"
    },
    "UseStorage": {
      "type": "computed",
      "value": "(storage == \"s3\")"
    },
    "UseDocuments": {
      "type": "computed",
      "value": "(documents)"
    },
    "UseSmtp": {
      "type": "computed",
      "value": "(email == \"smtp\")"
    },
    "UseAgents": {
      "type": "computed",
      "value": "(agents != \"none\")"
    },
    "UseClaude": {
      "type": "computed",
      "value": "(agents == \"claude\")"
    },
    "EffectiveDb": {
      "type": "generated",
      "generator": "switch",
      "replaces": "EK_EFFECTIVE_DB",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(UsePostgres)", "value": "postgres" },
          { "condition": "(UseSqlServer)", "value": "sqlserver" },
          { "condition": "(UseSqlite)", "value": "sqlite" },
          { "condition": "(true)", "value": "none" }
        ]
      }
    },
    "AuthValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "EK_AUTH",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(UseExternal)", "value": "external" },
          { "condition": "(UseIdentity)", "value": "identity" },
          { "condition": "(UseOidc)", "value": "oidc" },
          { "condition": "(true)", "value": "none" }
        ]
      }
    },
    "EmailValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "EK_EMAIL",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(UseSmtp)", "value": "smtp" },
          { "condition": "(true)", "value": "none" }
        ]
      }
    },
    "JobsValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "EK_JOBS",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(UseHangfire)", "value": "hangfire" },
          { "condition": "(UseHostedJobs)", "value": "hosted" },
          { "condition": "(true)", "value": "none" }
        ]
      }
    },
    "WorkerValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"EK_WORKER\"",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(UseWorker)", "value": "true" },
          { "condition": "(true)", "value": "false" }
        ]
      }
    },
    "AspireValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"EK_ASPIRE\"",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(UseAspire)", "value": "true" },
          { "condition": "(true)", "value": "false" }
        ]
      }
    },
    "StorageValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "EK_STORAGE",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(UseStorage)", "value": "s3" },
          { "condition": "(true)", "value": "none" }
        ]
      }
    },
    "DocumentsValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "\"EK_DOCUMENTS\"",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(UseDocuments)", "value": "true" },
          { "condition": "(true)", "value": "false" }
        ]
      }
    },
    "AgentsValue": {
      "type": "generated",
      "generator": "switch",
      "replaces": "EK_AGENTS",
      "parameters": {
        "evaluator": "C++",
        "datatype": "string",
        "cases": [
          { "condition": "(agents == \"claude\")", "value": "claude" },
          { "condition": "(agents == \"shared\")", "value": "shared" },
          { "condition": "(true)", "value": "none" }
        ]
      }
    },
    "AppSlug": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "slug",
      "replaces": "ek-app-slug",
      "description": "The project name made safe for Docker Compose project and image names."
    },
    "ProjectsPrefix": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "projectsPrefix",
      "replaces": "MyProject_",
      "description": "The project name as the AppHost's generated Projects class spells it."
    },
    "TemplateVersion": {
      "type": "generated",
      "generator": "constant",
      "replaces": "EK_TEMPLATE_VERSION",
      "parameters": {
        "value": "0.6.0"
      }
    }
  },
  "forms": {
    "slug": {
      "identifier": "chain",
      "steps": [ "slugLowerCase", "slugReplace" ]
    },
    "slugLowerCase": {
      "identifier": "lowerCaseInvariant"
    },
    "projectsPrefix": {
      "identifier": "chain",
      "steps": [ "projectsPrefixChars", "projectsPrefixEnd" ]
    },
    "projectsPrefixChars": {
      "identifier": "replace",
      "pattern": "[^A-Za-z0-9_]",
      "replacement": "_"
    },
    "projectsPrefixEnd": {
      "identifier": "replace",
      "pattern": "$",
      "replacement": "_"
    },
    "slugReplace": {
      "identifier": "replace",
      "pattern": "[^a-z0-9]+",
      "replacement": "-"
    }
  },
