<Project>
  <!-- Every package version lives here (central package management). Dependabot keeps them current. -->
  <ItemGroup Label="API">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.5" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>
<!--#if (UseSmtp) -->
  <ItemGroup Label="Email">
    <PackageVersion Include="MailKit" Version="4.18.2" />
  </ItemGroup>
<!--#endif -->
<!--#if (UseDatabase) -->
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
<!--#if (UsePostgres) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
<!--#elif (UseSqlServer) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Microsoft.Data.SqlClient brings 9.0.11, which has known vulnerabilities. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
<!--#elif (UseSqlite) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (UseIdentity) -->
  <ItemGroup Label="Identity">
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
<!--#if (UseExternal) -->
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (UseOidc) -->
  <ItemGroup Label="OpenID Connect">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
  </ItemGroup>
<!--#endif -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
<!--#if (UseIdentity) -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.14" />
<!--#endif -->
<!--#if (UseSmtp) -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
<!--#endif -->
<!--#if (UsePostgres) -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
<!--#elif (UseSqlServer) -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
<!--#endif -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
