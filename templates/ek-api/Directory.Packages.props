<Project>
  <!-- Every package version lives here (central package management). Dependabot keeps them current. -->
  <ItemGroup Label="API">
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.5" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <!-- Retries, circuit breakers and timeouts for outbound HTTP (Polly underneath). -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
  </ItemGroup>
<!--#if (UseSmtp) -->
  <ItemGroup Label="Email">
    <PackageVersion Include="MailKit" Version="4.18.2" />
  </ItemGroup>
<!--#endif -->
<!--#if (UseDatabase) -->
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.14" />
<!--#if (UsePostgres) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
<!--#elif (UseSqlServer) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Microsoft.Data.SqlClient brings 9.0.11, which has known vulnerabilities. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
<!--#elif (UseSqlite) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (UseHostedJobs) -->
  <ItemGroup Label="Jobs">
    <PackageVersion Include="Cronos" Version="0.13.0" />
  </ItemGroup>
<!--#endif -->
<!--#if (UseHangfire) -->
  <ItemGroup Label="Jobs">
    <!-- Hangfire is LGPL-3.0 (free for commercial use); Hangfire Pro is not needed. -->
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
<!--#if (UsePostgres) -->
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
<!--#elif (UseSqlServer) -->
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
<!--#elif (UseSqlite) -->
    <PackageVersion Include="Hangfire.Storage.SQLite" Version="0.4.3" />
<!--#endif -->
    <!-- Hangfire.Core asks for 11.0.1, which has a known vulnerability. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
<!--#endif -->
<!--#if (UseAspire && (UsePostgres || UseSqlServer)) -->
  <ItemGroup Label="Aspire">
    <!-- The AppHost's SDK version is in src/MyProject.AppHost/MyProject.AppHost.csproj; keep them equal. -->
<!--#if (UsePostgres) -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.4" />
<!--#else -->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.4" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (UseIdentity) -->
  <ItemGroup Label="Identity">
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.14" />
<!--#if (UseExternal) -->
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
<!--#endif -->
  </ItemGroup>
<!--#endif -->
<!--#if (UseDocuments) -->
  <ItemGroup Label="Documents">
    <!-- Apache-2.0. Not ClosedXML (it needs SixLabors.Fonts) and not PDFsharp 6.5+ (AGPL) or QuestPDF (paid above a revenue limit). -->
    <PackageVersion Include="MiniExcel" Version="1.46.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
<!--#endif -->
<!--#if (UseStorage) -->
  <ItemGroup Label="Files">
    <!-- All Apache-2.0 or MIT. Not ImageSharp: its licence needs a paid licence above a revenue limit. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageVersion Include="SkiaSharp" Version="4.154.0" />
    <!-- Skia's native library without fontconfig, so it runs in the chiseled container image. -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.154.0" />
    <PackageVersion Include="tusdotnet" Version="2.12.0" />
  </ItemGroup>
<!--#endif -->
<!--#if (UseOidc) -->
  <ItemGroup Label="OpenID Connect">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
  </ItemGroup>
<!--#endif -->
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
<!--#if (UseIdentity) -->
    <PackageVersion Include="System.Formats.Cbor" Version="10.0.14" />
<!--#endif -->
<!--#if (UseRealtime) -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
<!--#endif -->
<!--#if (UseSmtp || UseStorage) -->
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
<!--#endif -->
<!--#if (UsePostgres) -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
<!--#elif (UseSqlServer) -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
<!--#endif -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
